9\u7684\u65e5\u7a0b\u5c0f\u8f6f\u4ef6\u300c\u9752\u5e8f\u300d\uff0c\u6b22\u8fce\u6765\u73a9\u3002</p> </li> <li> <p>2026-09-15\uff1a\u7535\u5b50\u5de5\u7a0b\u8bad\u7ec3\u5b9e\u9a8c\u62a5\u544a\u66f4\u65b0\u3002</p> </li> </ul>"},{"location":"#_4","title":"\u6b63\u5728\u5b66\u4e60","text":"<ul> <li>\u6982\u7387\u8bba\u4e0e\u6570\u7406\u7edf\u8ba1</li> <li>\u5927\u5b66\u7269\u7406</li> </ul>"},{"location":"#_5","title":"\u5efa\u8bbe\u4e2d\u2026\u2026","text":""},{"location":"about/","title":"\u5173\u4e8e AmbrO","text":"<ul> <li>\u73a9\u70b9cos\uff0c\u53ef\u4ee5\u53eb\u6211\u5f20\u5927\u68a8/\u5f20\u5f20\uff0c\u91cd\u5e86/\u676d\u5dde\u957f\u671f\u8e72cos\u6444\u5f71\u4e92\u52c9\uff01</li> <li>\u5927e\u4eba\uff0c\u8001\u5e08\u4eec\u7ea6\u672c\u8bf7\u79c1\u6211plz\uff01</li> </ul>"},{"location":"movies/","title":"\u7535\u5f71\u65f6\u523b","text":""},{"location":"notes/electric_train/basic-experiment/","title":"\u57fa\u7840\u5b9e\u9a8c\u62a5\u544a","text":"<p>\u8fd4\u56de\u62a5\u544a\u76ee\u5f55</p>"},{"location":"notes/electric_train/basic-experiment/#_2","title":"\u5728\u7ebf\u9884\u89c8","text":""},{"location":"notes/electric_train/basic-experiment/#_3","title":"\u4e0b\u8f7d\u62a5\u544a","text":"<p>\ud83d\udce5 \u4e0b\u8f7d\u57fa\u7840\u5b9e\u9a8c\u62a5\u544a\uff08PDF\uff09</p> <p>\u5982\u679c\u4e0a\u65b9\u65e0\u6cd5\u9884\u89c8\uff0c\u53ef\u4ee5\u5355\u72ec\u6253\u5f00 PDF\u3002</p>"},{"location":"notes/electric_train/car-prelab/","title":"\u5c0f\u8f66\u9884\u4e60\u62a5\u544a","text":"<p>\u8fd4\u56de\u62a5\u544a\u76ee\u5f55</p>"},{"location":"notes/electric_train/car-prelab/#_2","title":"\u5728\u7ebf\u9884\u89c8","text":""},{"location":"notes/electric_train/car-prelab/#_3","title":"\u4e0b\u8f7d\u62a5\u544a","text":"<p>\ud83d\udce5 \u4e0b\u8f7d\u5c0f\u8f66\u9884\u4e60\u62a5\u544a\uff08PDF\uff09</p> <p>\u5982\u679c\u4e0a\u65b9\u65e0\u6cd5\u9884\u89c8\uff0c\u53ef\u4ee5\u5355\u72ec\u6253\u5f00 PDF\u3002</p>"},{"location":"notes/electric_train/first/","title":"\u63d2\u5ea